#!/usr/bin/env bash
#
# aria2-panel: helper for the aria2 web panel installed by install.sh.
#
#   sudo aria2-panel status              check that everything is working
#   sudo aria2-panel url                 show the panel links
#   sudo aria2-panel logs [name]         live logs: aria2, panel, nginx, tunnel
#   sudo aria2-panel restart             restart all services
#   sudo aria2-panel update              update to the latest version
#   sudo aria2-panel password [user] [new-password]
#                                        reset a password (default user: admin)
#   sudo aria2-panel users               list panel users
#
set -uo pipefail

PANEL_CONF="/etc/aria2/panel.json"
SAVED_CONF="/etc/aria2-install.conf"
INSTALL_URL="https://raw.githubusercontent.com/ABNET-RAKIB-123/aria2/main/install.sh"
TUNNEL_METRICS="127.0.0.1:45678"

ok()   { printf '  \033[1;32m✔\033[0m %s\n' "$*"; }
bad()  { printf '  \033[1;31m✘\033[0m %s\n' "$*"; FAILED=1; }
info() { printf '  • %s\n' "$*"; }
head_() { printf '\n\033[1m%s\033[0m\n' "$*"; }

need_root() {
  [[ $EUID -eq 0 ]] || { echo "sudo দিয়ে চালান: sudo aria2-panel $*"; exit 1; }
}

saved() { { [[ -f "$SAVED_CONF" ]] && sed -n "s/^$1=//p" "$SAVED_CONF" | head -n1; } || true; }

has_unit() { systemctl cat "$1" >/dev/null 2>&1; }

tunnel_url() {
  curl -fsS --max-time 2 "http://${TUNNEL_METRICS}/quicktunnel" 2>/dev/null \
    | sed -n 's/.*"hostname":"\([^"]*\)".*/https:\/\/\1/p'
}

public_ip() {
  curl -fsS --max-time 5 https://api.ipify.org 2>/dev/null || hostname -I | awk '{print $1}'
}

cmd_url() {
  local domain t
  domain="$(saved DOMAIN)"
  if [[ -n "$domain" ]]; then
    echo "Panel: https://${domain}/"
  else
    echo "Panel: http://$(public_ip)/"
  fi
  t="$(tunnel_url)"
  [[ -n "$t" ]] && echo "Tunnel (HTTPS): ${t}"
  return 0
}

cmd_status() {
  FAILED=0
  head_ "সার্ভিস"
  for svc in aria2 aria2-panel nginx; do
    if [[ "$(systemctl is-active "$svc" 2>/dev/null)" == "active" ]]; then ok "$svc চলছে"; else bad "$svc চলছে না  →  sudo aria2-panel logs ${svc#aria2-}"; fi
  done
  if has_unit aria2-tunnel; then
    if [[ "$(systemctl is-active aria2-tunnel)" == "active" ]]; then ok "Cloudflare Tunnel চলছে"; else bad "Cloudflare Tunnel চলছে না  →  sudo aria2-panel logs tunnel"; fi
  fi

  head_ "সংযোগ"
  local code
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 http://127.0.0.1:8090/ 2>/dev/null)"
  if [[ "$code" == "200" ]]; then ok "প্যানেল সাড়া দিচ্ছে"; else bad "প্যানেল সাড়া দিচ্ছে না (HTTP ${code:-none})"; fi
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 -H 'Host: localhost' http://127.0.0.1/ 2>/dev/null)"
  case "$code" in
    200 | 301 | 302 | 404) ok "nginx পোর্ট 80-তে চলছে" ;;
    *) bad "nginx পোর্ট 80-তে সাড়া দিচ্ছে না (HTTP ${code:-none})" ;;
  esac
  if ss -ltn 2>/dev/null | grep -q '127.0.0.1:6800'; then ok "aria2 RPC চালু"; else bad "aria2 RPC (পোর্ট 6800) চালু নেই"; fi

  head_ "লিংক"
  cmd_url | sed 's/^/  • /'
  info "লিংক কাজ না করলে ক্লাউড প্যানেলের ফায়ারওয়ালে পোর্ট 80 (আর HTTPS-এর জন্য 443) খুলুন"

  head_ "জায়গা আর মেমরি"
  local dir
  dir="$(python3 -c "import json;print(json.load(open('$PANEL_CONF'))['download_dir'])" 2>/dev/null || echo /srv/downloads)"
  df -h "$dir" 2>/dev/null | awk -v d="$dir" 'NR==2 {printf "  • ডাউনলোড ফোল্ডার %s: খালি %s / মোট %s (%s ব্যবহৃত)\n", d, $4, $2, $5}'
  free -h | awk '/^Mem/ {printf "  • RAM: মোট %s, খালি %s\n", $2, $7} /^Swap/ {printf "  • Swap: %s\n", $2}'

  head_ "টুলস"
  for t in aria2c rclone yt-dlp ffmpeg; do
    if command -v "$t" >/dev/null; then
      local v
      case "$t" in
        aria2c) v="$(aria2c --version | head -n1)" ;;
        rclone) v="$(rclone version 2>/dev/null | head -n1)" ;;
        yt-dlp) v="yt-dlp $(yt-dlp --version 2>/dev/null)" ;;
        ffmpeg) v="$(ffmpeg -version 2>/dev/null | head -n1 | cut -d' ' -f1-3)" ;;
      esac
      ok "$v"
    else
      bad "$t ইনস্টল নেই  →  sudo aria2-panel update"
    fi
  done
  if command -v 7zz >/dev/null || command -v 7z >/dev/null; then ok "7-Zip (zip/rar/7z খোলার জন্য)"; else bad "7-Zip ইনস্টল নেই"; fi

  head_ "Cloud"
  local remotes
  remotes="$(rclone --config /etc/aria2/rclone.conf listremotes 2>/dev/null | tr '\n' ' ')"
  if [[ -n "$remotes" ]]; then info "কানেক্ট করা: ${remotes}"; else info "কোনো Cloud একাউন্ট কানেক্ট করা নেই (প্যানেলের ☁ Cloud ট্যাব থেকে করুন)"; fi

  echo
  if [[ "${FAILED:-0}" == "1" ]]; then
    printf '\033[1;31mকিছু সমস্যা আছে।\033[0m উপরের ✘ চিহ্নগুলো দেখুন, অথবা চালান: sudo aria2-panel restart\n'
    return 1
  fi
  printf '\033[1;32mসব ঠিক আছে!\033[0m\n'
}

cmd_logs() {
  case "${1:-panel}" in
    aria2) journalctl -u aria2 -n 100 -f ;;
    panel) journalctl -u aria2-panel -n 100 -f ;;
    tunnel) journalctl -u aria2-tunnel -n 100 -f ;;
    nginx) tail -n 100 -f /var/log/nginx/error.log ;;
    *) echo "ব্যবহার: sudo aria2-panel logs [aria2|panel|nginx|tunnel]"; exit 1 ;;
  esac
}

cmd_restart() {
  local units=(aria2 aria2-panel nginx)
  has_unit aria2-tunnel && units+=(aria2-tunnel)
  systemctl restart "${units[@]}" && echo "রিস্টার্ট হয়েছে: ${units[*]}"
}

cmd_update() {
  curl -fsSL "$INSTALL_URL" | bash
}

cmd_password() {
  local user="${1:-admin}" pass="${2:-}"
  [[ -n "$pass" ]] || pass="$(openssl rand -base64 18 | tr -dc 'A-Za-z0-9' | head -c 14)"
  if [[ ${#pass} -lt 8 ]]; then echo "পাসওয়ার্ড কমপক্ষে ৮ অক্ষরের হতে হবে"; exit 1; fi
  PANEL_CONF="$PANEL_CONF" P_USER="$user" P_PASS="$pass" python3 - <<'PY' || exit 1
import hashlib, json, os, re, secrets, sys
path, user, password = os.environ["PANEL_CONF"], os.environ["P_USER"], os.environ["P_PASS"]
if not re.match(r"^[A-Za-z0-9_.-]{1,32}$", user):
    sys.exit("ভুল ইউজারনেম")
with open(path) as f:
    cfg = json.load(f)
users = cfg.setdefault("users", {})
info = users.get(user, {"role": "admin"})
info["salt"] = secrets.token_hex(16)
info["hash"] = hashlib.pbkdf2_hmac("sha256", password.encode(), info["salt"].encode(), 200000).hex()
users[user] = info
with open(path, "w") as f:
    json.dump(cfg, f, indent=2)
PY
  chown aria2:aria2 "$PANEL_CONF"
  chmod 600 "$PANEL_CONF"
  systemctl restart aria2-panel
  echo "ইউজার: ${user}"
  echo "নতুন পাসওয়ার্ড: ${pass}"
}

cmd_users() {
  python3 -c "
import json
for n, u in sorted(json.load(open('$PANEL_CONF')).get('users', {}).items()):
    print('%-20s %s' % (n, u['role']))"
}

case "${1:-help}" in
  status) need_root "$@"; cmd_status ;;
  url) need_root "$@"; cmd_url ;;
  logs) need_root "$@"; cmd_logs "${2:-panel}" ;;
  restart) need_root "$@"; cmd_restart ;;
  update) need_root "$@"; cmd_update ;;
  password) need_root "$@"; cmd_password "${2:-admin}" "${3:-}" ;;
  users) need_root "$@"; cmd_users ;;
  *)
    sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
